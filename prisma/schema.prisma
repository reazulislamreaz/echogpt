// EchoGPT Backend — Complete Normalized PostgreSQL Schema (Step 4 — Final)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
  PAST_DUE
  TRIALING
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
  OPTIONS
  HEAD
}

// ==========================================
// ENTITIES
// ==========================================

/// System access roles (e.g. USER, ADMIN).
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("roles")
}

/// Core user account record.
/// API keys are kept strictly out of this record.
model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  passwordHash    String    @map("password_hash")
  firstName       String?   @map("first_name")
  lastName        String?   @map("last_name")
  avatarUrl       String?   @map("avatar_url")
  isActive        Boolean   @default(true) @map("is_active")
  isEmailVerified Boolean   @default(false) @map("is_email_verified")
  roleId          String    @map("role_id") @db.Uuid
  role            Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  subscriptions           Subscription[]
  userAiProviders         UserAIProvider[]
  conversations           Conversation[]
  webSearches             WebSearch[]
  apiUsageLogs            APIUsageLog[]

  @@index([roleId])
  @@index([isActive])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("users")
}

/// User authentication sessions storing hashed refresh tokens.
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  revokedAt        DateTime? @map("revoked_at")
  expiresAt        DateTime  @map("expires_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Secure email verification token storage.
/// Only the hashed token is stored — never the raw token.
/// A token is single-use: once usedAt is set, it cannot be reused.
/// A token is time-bound: expiresAt is always checked before verification.
model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

/// Available subscription tiers (e.g. FREE, PREMIUM).
/// Plans can be added or adjusted dynamically without modifying the User model.
model SubscriptionPlan {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique
  slug         String   @unique
  description  String?
  price        Decimal  @default(0.00) @db.Decimal(10, 2)
  currency     String   @default("USD")
  billingCycle String   @default("monthly") @map("billing_cycle")
  /// Maximum number of requests allowed within the billing cycle.
  /// Nullable: NULL indicates an unlimited plan (e.g. enterprise or unrestricted tier).
  /// Remaining requests are computed dynamically as: (requestLimit - currentUsage).
  /// A duplicated "remainingRequests" column is intentionally omitted to avoid data drift.
  requestLimit Int?     @map("request_limit")
  features     Json?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  subscriptions          Subscription[]
  scheduledSubscriptions Subscription[] @relation("ScheduledPlan")

  @@map("subscription_plans")
}

/// User subscription records linking a user to a subscription plan.
/// currentPeriodStart/currentPeriodEnd define the active billing window
/// used to calculate remaining requests: requestLimit - COUNT(APIUsageLog in period).
model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @map("user_id") @db.Uuid
  user               User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  planId             String             @map("plan_id") @db.Uuid
  plan               SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  status             SubscriptionStatus @default(ACTIVE)
  startDate          DateTime           @default(now()) @map("start_date")
  endDate            DateTime?          @map("end_date")
  currentPeriodStart DateTime           @default(now()) @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  canceledAt         DateTime?          @map("canceled_at")
  /// Plan to activate when a scheduled downgrade reaches currentPeriodEnd.
  scheduledPlanId    String?            @map("scheduled_plan_id") @db.Uuid
  scheduledPlan      SubscriptionPlan?  @relation("ScheduledPlan", fields: [scheduledPlanId], references: [id], onDelete: SetNull)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([planId])
  @@index([endDate])
  @@index([scheduledPlanId])
  @@map("subscriptions")
}

/// Dynamic AI Provider registry (e.g. OPENAI, CLAUDE, GEMINI).
/// Supports adding future providers without modifying database structure.
/// System-level API key (encryptedApiKey) is the admin-configured default credential.
/// isDefault marks the system-wide default provider for users without explicit selection.
model AIProvider {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  slug            String   @unique
  description     String?
  baseUrl         String?  @map("base_url")
  encryptedApiKey String?  @map("encrypted_api_key")
  isActive        Boolean  @default(true) @map("is_active")
  isDefault       Boolean  @default(false) @map("is_default")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  userAiProviders UserAIProvider[]
  conversations   Conversation[]

  @@index([isActive])
  @@map("ai_providers")
}

/// Encrypted user-configured AI provider credentials.
/// Raw API keys must never be stored in plaintext.
model UserAIProvider {
  id              String     @id @default(uuid()) @db.Uuid
  userId          String     @map("user_id") @db.Uuid
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId      String     @map("provider_id") @db.Uuid
  provider        AIProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  encryptedApiKey String?    @map("encrypted_api_key")
  keyPreview      String?    @map("key_preview")
  isEnabled       Boolean    @default(true) @map("is_enabled")
  isDefault       Boolean    @default(false) @map("is_default")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  @@unique([userId, providerId])
  @@index([userId])
  @@index([providerId])
  @@map("user_ai_providers")
}

/// Chat conversations belonging to a user.
model Conversation {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @map("user_id") @db.Uuid
  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  providerId String?     @map("provider_id") @db.Uuid
  provider   AIProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  title      String      @default("New Conversation")
  model      String?
  deletedAt  DateTime?   @map("deleted_at")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  messages Message[]

  @@index([userId])
  @@index([updatedAt])
  @@index([providerId])
  @@index([deletedAt])
  @@map("conversations")
}

/// Messages within a conversation.
model Message {
  id               String       @id @default(uuid()) @db.Uuid
  conversationId   String       @map("conversation_id") @db.Uuid
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role             MessageRole
  content          String       @db.Text
  provider         String?
  model            String?
  promptTokens     Int?         @map("prompt_tokens")
  completionTokens Int?         @map("completion_tokens")
  totalTokens      Int?         @map("total_tokens")
  metadata         Json?
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  @@index([conversationId])
  @@index([createdAt])
  @@map("messages")
}

/// Web search queries and structured JSON results for grounding/retrieval.
model WebSearch {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  query       String   @db.Text
  provider    String
  results     Json
  resultCount Int      @default(0) @map("result_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([createdAt])
  @@map("web_searches")
}

/// Audit and analytics log for tracking API endpoint usage, tokens, and response latencies.
/// Supports admin dashboard analytics and request log views.
model APIUsageLog {
  id               String     @id @default(uuid()) @db.Uuid
  userId           String?    @map("user_id") @db.Uuid
  user             User?      @relation(fields: [userId], references: [id], onDelete: Restrict)
  requestId        String?    @map("request_id")
  endpoint         String
  method           HttpMethod
  provider         String?
  model            String?
  promptTokens     Int?       @map("prompt_tokens")
  completionTokens Int?       @map("completion_tokens")
  totalTokens      Int?       @map("total_tokens")
  statusCode       Int        @map("status_code")
  responseTimeMs   Int        @map("response_time_ms")
  ipAddress        String?    @map("ip_address")
  userAgent        String?    @map("user_agent")
  errorMessage     String?    @map("error_message")
  createdAt        DateTime   @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([provider])
  @@index([endpoint])
  @@index([requestId])
  @@index([statusCode])
  @@map("api_usage_logs")
}
