# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=1

# Database (PostgreSQL) — set locally; never commit real credentials
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=

# JWT Authentication
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Password & Security
BCRYPT_SALT_ROUNDS=10
EMAIL_VERIFICATION_EXPIRES_HOURS=24

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# CORS
CORS_ORIGIN=*
