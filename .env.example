# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=1

# Database (PostgreSQL) — set locally; never commit real credentials
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=

# JWT (placeholder — auth not implemented yet)
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=1d

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# CORS
CORS_ORIGIN=*
