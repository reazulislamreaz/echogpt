# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=1
CORS_ORIGIN=*
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# Database
DATABASE_URL=

# JWT / Auth
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
EMAIL_VERIFICATION_EXPIRES_HOURS=24

# Encryption
ENCRYPTION_KEY=

# SMTP / Email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=EchoGPT
EMAIL_VERIFICATION_URL=http://localhost:3000/api/v1/auth/verify-email
EMAIL_MOCK=false

# AI / External Services
AI_COMPLETION_MOCK=false
AI_REQUEST_TIMEOUT_MS=30000
WEB_SEARCH_MOCK=false
WEB_SEARCH_PROVIDER=serper
WEB_SEARCH_API_KEY=
WEB_SEARCH_BASE_URL=
WEB_SEARCH_TIMEOUT_MS=15000
WEB_SEARCH_DEFAULT_LIMIT=10
