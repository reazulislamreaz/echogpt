# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=1

# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=

# JWT Authentication
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Password & Security
BCRYPT_SALT_ROUNDS=10
EMAIL_VERIFICATION_EXPIRES_HOURS=24

# SMTP email delivery (all SMTP_* + EMAIL_VERIFICATION_URL must be set together)
# App starts without SMTP; verification emails fail safely until configured.
# Gmail example: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_SECURE=false
# Use a Gmail App Password (not your normal account password) when using Gmail SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=EchoGPT
EMAIL_VERIFICATION_URL=http://localhost:3000/api/v1/auth/verify-email
# Set EMAIL_MOCK=true in automated tests to skip real SMTP delivery
EMAIL_MOCK=false

# AES-256-GCM key material for encrypting AI provider API keys (use a long random string)
ENCRYPTION_KEY=

# AI completion (set AI_COMPLETION_MOCK=true for local/e2e without live provider calls)
AI_COMPLETION_MOCK=false
AI_REQUEST_TIMEOUT_MS=30000

# Web search (set WEB_SEARCH_MOCK=true for local/e2e without live provider calls)
WEB_SEARCH_MOCK=false
WEB_SEARCH_PROVIDER=serper
WEB_SEARCH_API_KEY=
WEB_SEARCH_BASE_URL=
WEB_SEARCH_TIMEOUT_MS=15000
WEB_SEARCH_DEFAULT_LIMIT=10

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# CORS
CORS_ORIGIN=*
