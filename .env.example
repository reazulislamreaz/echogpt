# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=1

# Database (PostgreSQL) — set locally; never commit real credentials
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=

# JWT Authentication
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Password & Security
BCRYPT_SALT_ROUNDS=10
EMAIL_VERIFICATION_EXPIRES_HOURS=24

# AES-256-GCM key material for encrypting AI provider API keys (use a long random string)
ENCRYPTION_KEY=

# AI completion (set AI_COMPLETION_MOCK=true for local/e2e without live provider calls)
AI_COMPLETION_MOCK=false
AI_REQUEST_TIMEOUT_MS=30000

# Web search (set WEB_SEARCH_MOCK=true for local/e2e without live provider calls)
WEB_SEARCH_MOCK=false
WEB_SEARCH_PROVIDER=serper
WEB_SEARCH_API_KEY=
WEB_SEARCH_BASE_URL=
WEB_SEARCH_TIMEOUT_MS=15000
WEB_SEARCH_DEFAULT_LIMIT=10

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# CORS
CORS_ORIGIN=*
