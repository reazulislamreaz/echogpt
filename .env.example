# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=1
CORS_ORIGIN=*
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# Database
DATABASE_URL=postgresql://echogpt:echogpt@localhost:5432/echogpt?schema=public

# JWT / Auth
JWT_ACCESS_SECRET=dev-access-secret-do-not-use-in-production-12345
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
EMAIL_VERIFICATION_EXPIRES_HOURS=24
REQUIRE_EMAIL_VERIFICATION=false

# Seeded admin account (required for prisma seed; never commit real values)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Encryption
ENCRYPTION_KEY=dev-local-encryption-key-change-me-32chars

# SMTP / Email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=EchoGPT
# Used only when SMTP is fully configured. A URL by itself does not enable email.
EMAIL_VERIFICATION_URL=http://localhost:3000/api/v1/auth/verify-email
EMAIL_MOCK=false

# Redis (optional — leave REDIS_HOST empty to disable)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=echogpt:
REDIS_CONNECT_TIMEOUT_MS=2000
REDIS_COMMAND_TIMEOUT_MS=1000

# HTTP rate limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# AI / External Services
AI_COMPLETION_MOCK=false
AI_REQUEST_TIMEOUT_MS=30000
WEB_SEARCH_MOCK=false
WEB_SEARCH_PROVIDER=serper
WEB_SEARCH_API_KEY=
WEB_SEARCH_BASE_URL=
WEB_SEARCH_TIMEOUT_MS=15000
WEB_SEARCH_DEFAULT_LIMIT=10
WEB_SEARCH_CACHE_TTL_SECONDS=300
